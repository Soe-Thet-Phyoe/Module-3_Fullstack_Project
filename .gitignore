# JavaScript dependencies and package-manager state
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches/
!**/.yarn/plugins/
!**/.yarn/releases/
!**/.yarn/versions/

# Next.js and build output
**/.next/
**/out/
**/build/
**/coverage/
**/.vercel/

# Environment and local secrets
.env*
!.env.example
!**/.env.example

# TypeScript and logs
**/*.tsbuildinfo
**/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python virtual environments, caches, and generated files
server/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/staticfiles/
*.sqlite3

# OS and local certificate files
.DS_Store
Thumbs.db
*.pem
